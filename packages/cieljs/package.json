    "@cieljs/mcp": "workspace:*",
    "@cieljs/memory": "workspace:*",
    "@cieljs/model-kit": "workspace:*",
    "@cieljs/perception": "workspace:*",
    "@cieljs/runtime": "workspace:*",
    "@cieljs/session": "workspace:*",
    "@cieljs/storage": "workspace:*",
    "@cieljs/trace": "workspace:*",
    "@cieljs/vector": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cieljs": "workspace:*",
    "typebox": "catalog:",
